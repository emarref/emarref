{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "emarref-net",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-25",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // The redirect has to beat asset serving, otherwise www.emarref.net/
    // would be answered with index.html instead of a 301.
    "run_worker_first": true
  },
  "routes": [
    { "pattern": "emarref.net", "custom_domain": true },
    { "pattern": "www.emarref.net", "custom_domain": true }
  ],
  "observability": { "enabled": true }
}
